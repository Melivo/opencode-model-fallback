{
  "branches": ["main"],
  "tagFormat": "melivo-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          {
            "breaking": true,
            "release": "minor"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun scripts/prepare-release.ts ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false,
        "tarballDir": "release-artifacts"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun run test:package --tarball release-artifacts/melivo-opencode-model-fallback-${nextRelease.version}.tgz && sha512sum release-artifacts/melivo-opencode-model-fallback-${nextRelease.version}.tgz > release-artifacts/tested.sha512",
        "publishCmd": "test \"$(git ls-remote origin refs/heads/main | cut -f1)\" = \"$GITHUB_SHA\" && sha512sum --check release-artifacts/tested.sha512 && \"$RELEASE_NPM\" publish release-artifacts/melivo-opencode-model-fallback-${nextRelease.version}.tgz --access public --tag latest --registry https://registry.npmjs.org/ && bun scripts/prepare-release.ts --verify-registry ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-artifacts/melivo-opencode-model-fallback-${nextRelease.version}.tgz",
            "label": "Tested npm package"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "labels": false,
        "releasedLabels": false
      }
    ]
  ]
}
