{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "ide",
          "--tool-timeout",
          "10"
        ],
        "timeout": {
          "startup": 10000
        }
      }
    }
  }
}
